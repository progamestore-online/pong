{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "progamestore-pong",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",

  // Multiplayer Worker only — serves /api/rooms/* for WebSocket DO.
  // Static SPA is hosted on R2 via the shared host worker.

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],

  "routes": [
    { "pattern": "pong.progamestore.online/api/*", "zone_name": "progamestore.online" }
  ]
}
